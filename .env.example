# TaskFlow Pro Environment Variables
# Copy this to backend/.env and fill in your values

DATABASE_URL=sqlite+aiosqlite:///./taskflow.db

# Get your free API key from https://build.nvidia.com
# Sign in → Generate API Key (starts with "nvapi-")
NVIDIA_API_KEY=nvapi-your-key-here

# Model to use (see https://build.nvidia.com/models for available models)
# Free models: deepseek-ai/deepseek-r1, meta/llama-3.3-70b-instruct, nvidia/nemotron-3.5-lightning
NVIDIA_MODEL=deepseek-ai/deepseek-r1
