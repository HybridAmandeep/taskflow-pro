# ==============================================================================
# TaskFlow Pro — Backend Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and provide your settings:
#   cp .env.example .env
# ==============================================================================

# Database Connection (SQLite with async aiosqlite driver by default)
DATABASE_URL=sqlite+aiosqlite:///./taskflow.db

# Google Gemini API Configuration (for AI-powered dependency suggestions)
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
# Keys starting with AIzaSy... or AQ... are fully supported.
# If omitted or empty, the application runs normally with AI features gracefully disabled.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier
# Default: gemini-3.8-flash (recommended modern model)
GEMINI_MODEL=gemini-3.8-flash

# Port for local development / cloud hosting (optional, default 8000)
PORT=8000
